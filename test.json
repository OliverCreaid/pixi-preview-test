  "return": "{\n  \"title\": \"Bergstaðastræti 46\",\n  \"music_search\": \"light corporate\",\n  \"scene_count\": 6,\n  \"min_input_images\": 10,\n  \"scenes\": [\n    {\n      \"scene_index\": 0,\n      \"image_count\": 2,\n      \"voice_over\": \"Við kynnum bjarta og fallega þriggja herbergja íbúð við Bergstaðastræti í Þingholtunum, á eftirsóttum stað.\",\n      \"on_screen_text\": \"Bergstaðastræti 46\",\n      \"image_list\": [\n        19,\n        20\n      ]\n    regex.exec\n    },\n    {\n      \"scene_index\": 1,\n      \"image_count\": 2,\n      \"voice_over\": \"Stofan er björt og rúmgóð með parketi á gólfi, og rýmið býður upp á ýmsa möguleika.\",\n      \"on_screen_text\": \"Björt og rúmgóð stofa\",\n      \"image_list\": [\n        4,\n        6\n      ]\n    },\n    {\n      \"scene_index\": 2,\n      \"image_count\": 2,\n      \"voice_over\": \"Eldhúsið er snyrtilegt með góðu skápaplássi, og þar er góður borðkrókur fyrir fjölskylduna.\",\n      \"on_screen_text\": \"Snyrtilegt eldhús með borðkrók\",\n      \"image_list\": [\n        14,\n        15\n      ]\n    },\n    {\n      \"scene_index\": 3,\n      \"image_count\": 2,\n      \"voice_over\": \"Tvö rúmgóð svefnherbergi eru í íbúðinni, og bæði eru með fallegu parketi á gólfi.\",\n      \"on_screen_text\": \"Tvö rúmgóð svefnherbergi\",\n      \"image_list\": [\n        0,\n        2\n      ]\n    },\n    {\n      \"scene_index\": 4,\n      \"image_count\": 2,\n      \"voice_over\": \"Baðherbergið er flísalagt í hólf og gólf með baðkari og sturtu, og nýleg rafmagnstafla er í húsinu.\",\n      \"on_screen_text\": \"Flísalagt baðherbergi\",\n      \"image_list\": [\n        16,\n        17\n      ]\n    },\n    {\n      \"scene_index\": 5,\n      \"image_count\": 0,\n      \"voice_over\": \"Hafðu samband við Trausti fasteignasölu og bókaðu skoðun í dag.\",\n      \"on_screen_text\": \"Bókið skoðun!\",\n      \"image_list\": []\n    }\n  ]\n}",
